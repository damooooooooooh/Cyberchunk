# Database Configuration (for application)
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=cyberchunk

# Docker PostgreSQL Configuration (optional - override docker-compose.yml defaults)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=cyberchunk
# POSTGRES_HOST_PORT=5434
# POSTGRES_PORT=5432

# Ollama Configuration (if using Ollama)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_LLM_MODEL=llama3.2:latest

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# AWS Bedrock Configuration (if using Bedrock)
AWS_REGION=us-east-1
AWS_PROFILE=default

# Optional: Override default config file location
# CONFIG_PATH=rag_builder/config/main_config.yml
